# --- Contact form email delivery (optional) -------------------------------
# Copy this file to `.env.local` and fill in the values there.
# `.env.local` is gitignored; this template is committed, so keep it secret-free.
#
# Without these the form still works: it validates the message, then hands it
# to the visitor's own email app via a prefilled mailto link.
# Set them to have messages delivered straight to the inbox instead.

# API key from https://resend.com (free tier: 3,000 emails/month)
RESEND_API_KEY=

# Where contact-form messages are delivered.
# Defaults to the email in src/data/resume.ts if unset.
CONTACT_TO_EMAIL=palaksaxena132@gmail.com

# Sender address. Resend's shared testing sender works immediately;
# swap it for an address on your own verified domain for production.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
